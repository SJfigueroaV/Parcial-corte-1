@startuml ClinicaVeterinaria
skinparam classAttributeIconSize 0
title Diagrama de Clases - Clinica Veterinaria

interface IVacunable {
    + registrarVacuna(vacuna : String) : void
    + consultarEsquemaVacunacion() : String
}

class Mascota {
    - id : String
    - nombre : String
    - edad : int
    + Mascota(id : String, nombre : String, edad : int)
    + getId() : String
    + getNombre() : String
    + getEdad() : int
    + setEdad(edad : int) : void
    + getHistorial() : HistorialClinico
    + asignarVeterinario(v : Veterinario) : void
}

class HistorialClinico {
    - fechaApertura : LocalDate
    - observaciones : List<String>
    + HistorialClinico()
    + agregarObservacion(obs : String) : void
    + getObservaciones() : List<String>
}

class Veterinario {
    - cedula : String
    - especialidad : String
    + Veterinario(cedula : String, especialidad : String)
    + getCedula() : String
    + getEspecialidad() : String
}

class Perro {
    - raza : String
    + Perro(id : String, nombre : String, edad : int, raza : String)
    + registrarVacuna(vacuna : String) : void
    + consultarEsquemaVacunacion() : String
}

class Gato {
    - esInterior : boolean
    + Gato(id : String, nombre : String, edad : int, esInterior : boolean)
    + registrarVacuna(vacuna : String) : void
    + consultarEsquemaVacunacion() : String
}

HistorialClinico "1" --* "1" Mascota : contiene >

Veterinario "1" --o "0..*" Mascota : atendido por >

Perro --|> Mascota
Gato  --|> Mascota

Perro ..|> IVacunable
Gato  ..|> IVacunable

note right of Mascota
    Composicion (rombo negro):
    el historial se crea en el
    constructor de Mascota y se
    destruye con ella.
end note

note bottom of Veterinario
    Agregacion (rombo blanco):
    el veterinario existe de forma
    independiente y puede ser
    reasignado a otros pacientes.
end note
@enduml
